  "ngu_van/chuong-1/bai-03": {"ly_thuyet":"\u003cp\u003e\u003cb\u003eÔN TẬP KIẾN THỨC BÀI 3\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003eHỒN NƯỚC NẰM TRONG TIẾNG MẸ CHA\u003c/b\u003e\u003c/p\u003e\u003cdiv style=\"overflow-x:auto\"\u003e\u003ctable style=\"border-collapse:collapse;margin:8px 0;min-width:60%\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth style=\"border:1px solid #dfe5ee;padding:6px 10px;background:#f5f8ff;text-align:left\"\u003e\u003cb\u003eYÊU CẦU CẦN ĐẠT SAU BÀI 3\u003c/b\u003e\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e• Nhận biết và phân tích được đặc điểm của truyện thơ Nôm.\u003cbr\u003e• Phân biệt được lời người kể chuyện, lời nhân vật; lời đối thoại và lời độc thoại.\u003cbr\u003e• Nắm được những nét cơ bản về chữ Nôm và chữ quốc ngữ.\u003cbr\u003e• Viết được bài văn nghị luận về một vấn đề cần giải quyết trong đời sống, biết đề xuất giải pháp phù hợp.\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003cp\u003eI/ TRI THỨC VĂN HỌC\u003c/p\u003e\u003cp\u003e\u003cb\u003e1.1/ Truyện thơ Nôm là gì?\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eTruyện thơ Nôm là thể loại truyện được viết bằng chữ Nôm, có hình thức thơ ca và nội dung tự sự.\u003c/li\u003e\u003cli\u003eThời gian hình thành và phát triển:\u003cul\u003e\u003cli\u003eXuất hiện khoảng thế kỉ XVI – XVII.\u003c/li\u003e\u003cli\u003ePhát triển mạnh vào cuối thế kỉ XVIII và nửa đầu thế kỉ XIX.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eHình thức thơ:\u003cul\u003e\u003cli\u003eNhững tác phẩm đầu tiên có thể được viết theo thể thơ Đường luật hoặc song thất lục bát.\u003c/li\u003e\u003cli\u003eVề sau, thể thơ lục bát được sử dụng phổ biến.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eMột số tác phẩm tiêu biểu: _Phạm Tải – Ngọc Hoa_; _Sơ kính tân trang_; _Truyện Lục Vân Tiên_; _Truyện Kiều;..._\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e1.2/ Đặc điểm của truyện thơ Nôm\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e- - Đề tài, chủ đề và nội dung:\u003cul\u003e\u003cli\u003eĐề tài phong phú, phản ánh nhiều phương diện của đời sống con người và xã hội.\u003c/li\u003e\u003cli\u003eThể hiện giá trị hiện thực và giá trị nhân đạo:\u003cul\u003e\u003cli\u003ePhản ánh những bất công, ngang trái trong xã hội.\u003c/li\u003e\u003cli\u003eBày tỏ sự cảm thông với số phận con người.\u003c/li\u003e\u003cli\u003eĐề cao phẩm chất tốt đẹp, khát vọng về tình yêu, hạnh phúc và công lí.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eCốt truyện:\u003cul\u003e\u003cli\u003eCốt truyện thường được xây dựng theo trình tự các sự việc có quan hệ với nhau.\u003c/li\u003e\u003cli\u003eMột mô hình cốt truyện phổ biến là:\u003cul\u003e\u003cli\u003eGặp gỡ: Nhân vật gặp nhau, nảy sinh tình cảm hoặc mối quan hệ.\u003c/li\u003e\u003cli\u003eChia li: Nhân vật phải trải qua những biến cố, thử thách, bất hạnh.\u003c/li\u003e\u003cli\u003eĐoàn tụ: Những khó khăn được giải quyết, nhân vật có cơ hội sum họp hoặc đạt được hạnh phúc.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eCốt truyện thường có những biến cố, tình huống nhằm thể hiện số phận và phẩm chất nhân vật.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eNhân vật:\u003cul\u003e\u003cli\u003eNhân vật thường được xây dựng với những phẩm chất, tính cách tương đối rõ nét.\u003c/li\u003e\u003cli\u003eNhân vật chính diện thường có những đặc điểm:\u003cul\u003e\u003cli\u003eNgoại hình đẹp, tài năng, thông minh;\u003c/li\u003e\u003cli\u003eCó phẩm chất đạo đức tốt đẹp, giàu tình nghĩa;\u003c/li\u003e\u003cli\u003eThường phải trải qua những bất hạnh, thử thách và bất công;\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eCác phương diện khắc họa nhân vật:\u003cul\u003e\u003cli\u003eNgoại hình: diện mạo, dáng vẻ;\u003c/li\u003e\u003cli\u003eLời nói: cách giao tiếp, ứng xử;\u003c/li\u003e\u003cli\u003eCử chỉ, hành động: biểu hiện tính cách và phẩm chất;\u003c/li\u003e\u003cli\u003eNội tâm: tình cảm, suy nghĩ, tâm trạng và diễn biến tâm lí;\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLời thoại\u003c/li\u003e\u003cli\u003eLời thoại là phương tiện quan trọng giúp nhân vật bộc lộ tính cách, tình cảm và tâm trạng.\u003c/li\u003e\u003cli\u003eQua lời thoại, người đọc có thể nhận biết:\u003cul\u003e\u003cli\u003eTính cách, phẩm chất của nhân vật.\u003c/li\u003e\u003cli\u003eMối quan hệ giữa các nhân vật.\u003c/li\u003e\u003cli\u003eTâm trạng, suy nghĩ và thái độ của nhân vật trước sự việc.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e1.3/ Lời người kể chuyện và lời nhân vật\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eLời người kể chuyện\u003cul\u003e\u003cli\u003eLà lời của người kể chuyện dùng để kể lại, miêu tả hoặc thuật lại các sự việc trong văn bản.\u003c/li\u003e\u003cli\u003eCó vai trò:\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eDẫn dắt diễn biến câu chuyện.\u003c/li\u003e\u003cli\u003eGiới thiệu nhân vật, sự việc và hoàn cảnh.\u003c/li\u003e\u003cli\u003eMiêu tả ngoại hình, hành động, tâm trạng của nhân vật.\u003c/li\u003e\u003cli\u003eLời nhân vật\u003cul\u003e\u003cli\u003eLà lời nói hoặc lời diễn đạt suy nghĩ, cảm xúc của nhân vật trong tác phẩm.\u003c/li\u003e\u003cli\u003eGiúp thể hiện tính cách, tâm trạng, suy nghĩ và mối quan hệ của nhân vật.\u003c/li\u003e\u003cli\u003eLời nhân vật gồm hai hình thức cơ bản:\u003cul\u003e\u003cli\u003eLời đối thoại.\u003c/li\u003e\u003cli\u003eLời độc thoại.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e1.4/ Lời đối thoại và lời độc thoại\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eLời đối thoại\u003cul\u003e\u003cli\u003eKhái niệm: là lời của nhân vật nói với một hoặc nhiều nhân vật khác đang trực tiếp tham gia vào cuộc giao tiếp.\u003c/li\u003e\u003cli\u003eĐặc điểm:\u003cul\u003e\u003cli\u003eThường xuất hiện trong các cuộc trò chuyện, trao đổi giữa nhân vật.\u003c/li\u003e\u003cli\u003eCó sự tương tác giữa người nói và người nghe.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eTác dụng:\u003cul\u003e\u003cli\u003eThể hiện tính cách, thái độ và tình cảm của nhân vật.\u003c/li\u003e\u003cli\u003eLàm rõ mối quan hệ giữa các nhân vật.\u003c/li\u003e\u003cli\u003eGóp phần thúc đẩy diễn biến câu chuyện.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLời độc thoại\u003cul\u003e\u003cli\u003eKhái niệm: là lời nhân vật tự nói với chính mình, không nhằm hướng đến một người đối thoại trực tiếp.\u003c/li\u003e\u003cli\u003eGồm hai hình thức:\u003cul\u003e\u003cli\u003eĐộc thoại thành tiếng: Nhân vật tự nói thành lời.\u003c/li\u003e\u003cli\u003eĐộc thoại nội tâm: Suy nghĩ, cảm xúc của nhân vật được thể hiện trong tâm trí.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eTác dụng:\u003cul\u003e\u003cli\u003eBộc lộ suy nghĩ, tình cảm và tâm trạng bên trong của nhân vật.\u003c/li\u003e\u003cli\u003eGiúp người đọc hiểu rõ hơn đời sống nội tâm và diễn biến tâm lí nhân vật.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e_II/ TRI THỨC TIẾNG VIỆT_\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003e2.1/ Chữ Nôm\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eKhái niệm:\u003c/li\u003e\u003cli\u003eChữ Nôm là hệ thống chữ viết được người Việt sáng tạo dựa trên cơ sở chữ Hán để ghi âm và ghi nghĩa tiếng Việt.\u003cul\u003e\u003cli\u003eChữ Nôm được sử dụng rộng rãi trong sáng tác văn học, đặc biệt là các tác phẩm truyện thơ Nôm.\u003cul\u003e\u003cli\u003eCách cấu tạo chữ Nôm:\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eChữ Nôm được hình thành bằng hai cách cơ bản:\u003cul\u003e\u003cli\u003eMượn chữ Hán có sẵn: mượn chữ Hán để ghi âm tiếng Việt dựa trên âm Hán Việt hoặc sự gần gũi về âm đọc.\u003c/li\u003e\u003cli\u003eTạo chữ mới:\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eKết hợp các bộ phận của chữ Hán để tạo thành chữ Nôm.\u003c/li\u003e\u003cli\u003eCác bộ phận có thể gợi ý nghĩa hoặc gợi cách đọc của chữ.\u003c/li\u003e\u003cli\u003eVai trò:\u003c/li\u003e\u003cli\u003eGhi lại tiếng nói của dân tộc.\u003c/li\u003e\u003cli\u003eGóp phần phát triển nền văn học viết bằng tiếng Việt.\u003c/li\u003e\u003cli\u003eLưu giữ những giá trị văn hóa, lịch sử và ngôn ngữ của dân tộc.\u003c/li\u003e\u003cli\u003eHạn chế:\u003c/li\u003e\u003cli\u003eCấu tạo phức tạp, khó học và khó sử dụng.\u003c/li\u003e\u003cli\u003eNgười học cần có kiến thức về chữ Hán mới có thể đọc, viết chữ Nôm tương đối thuận lợi.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e2.2/ Chữ quốc ngữ\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e- - Khái niệm: là hệ thống chữ viết tiếng Việt sử dụng bảng chữ cái La-tinh kết hợp với các dấu thanh và dấu phụ để ghi âm tiếng Việt.\u003cul\u003e\u003cli\u003eQuá trình hình thành và phát triển: hình thành từ đầu thế kỉ XVII trong quá trình truyền giáo của các giáo sĩ phương Tây tại Việt Nam.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eMột số giáo sĩ có đóng góp trong lớn:\u003cul\u003e\u003cli\u003eFrancisco de Pina.\u003c/li\u003e\u003cli\u003eAlexandre de Rhodes.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eNgười Việt cũng có đóng góp trong quá trình hoàn thiện và phổ biến chữ quốc ngữ.\u003cul\u003e\u003cli\u003eSau Cách mạng tháng Tám năm 1945, chữ quốc ngữ trở thành hệ thống chữ viết chính thức được sử dụng rộng rãi trong cả nước.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eĐặc điểm:\u003cul\u003e\u003cli\u003eSử dụng chữ cái La-tinh.\u003c/li\u003e\u003cli\u003eCó hệ thống dấu thanh và dấu phụ để ghi âm tiếng Việt.\u003c/li\u003e\u003cli\u003eTương đối dễ học, dễ đọc và dễ sử dụng.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eVai trò:\u003cul\u003e\u003cli\u003eGóp phần phổ cập giáo dục và nâng cao dân trí.\u003c/li\u003e\u003cli\u003eTạo điều kiện thuận lợi cho việc truyền bá tri thức.\u003c/li\u003e\u003cli\u003eThúc đẩy sự phát triển của văn hóa, kinh tế và xã hội.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e_III/ TẬP LÀM VĂN_\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003e3.1/ Phạm vi vấn đề nghị luận\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eĐề tài: Những vấn đề đặt ra trong đời sống học sinh.\u003c/li\u003e\u003cli\u003eVấn đề nghị luận cụ thể: Tùy yêu cầu của đề bài, có thể là một vấn đề tiêu cực cần giải quyết, một hành động tích cực cần phát huy hoặc một vấn đề có nhiều khía cạnh cần xem xét.\u003c/li\u003e\u003cli\u003eNhiệm vụ chung: Làm rõ bản chất vấn đề, phân tích nguyên nhân, đánh giá tác động và đề xuất những giải pháp phù hợp, khả thi, có sức thuyết phục.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cb\u003e3.2/ Bố cục\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003eĐỀ VỀ VẤN ĐỀ TIÊU CỰC\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eMỞ BÀI (gián tiếp):\u003cul\u003e\u003cli\u003eDẫn dắt từ một nhận định, thực tế đời sống hoặc chính vấn đề.\u003c/li\u003e\u003cli\u003eGiới thiệu vấn đề tiêu cực cần nghị luận.\u003c/li\u003e\u003cli\u003eNhấn mạnh tính cấp thiết và sự cần thiết phải giải quyết vấn đề.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eTHÂN BÀI:\u003cul\u003e\u003cli\u003eLuận điểm 1: Giải thích và xác định bản chất vấn đề\u003cul\u003e\u003cli\u003eGiải thích khái niệm, từ khóa quan trọng.\u003c/li\u003e\u003cli\u003eNêu biểu hiện và thực trạng của vấn đề trong đời sống học sinh.\u003c/li\u003e\u003cli\u003eĐưa dẫn chứng tiêu biểu, xác thực.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLuận điểm 2: Phân tích nguyên nhân và hậu quả\u003cul\u003e\u003cli\u003ePhân tích nguyên nhân khách quan và chủ quan.\u003c/li\u003e\u003cli\u003eLàm rõ hậu quả đối với bản thân học sinh, gia đình, nhà trường và xã hội.\u003c/li\u003e\u003cli\u003eSử dụng lí lẽ và dẫn chứng để chứng minh mức độ nghiêm trọng của vấn đề.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLuận điểm 3: Phản biện ý kiến trái chiều\u003cul\u003e\u003cli\u003eXem xét những quan niệm hoặc hành vi sai lệch liên quan đến vấn đề.\u003c/li\u003e\u003cli\u003ePhản bác những ý kiến thiếu căn cứ, ngụy biện hoặc xem nhẹ hậu quả.\u003c/li\u003e\u003cli\u003eKhẳng định trách nhiệm của mỗi cá nhân và tập thể trong việc giải quyết vấn đề.\u003cul\u003e\u003cli\u003eLuận điểm 4: Đề xuất giải pháp\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eCá nhân: Nâng cao nhận thức, điều chỉnh thái độ và thay đổi hành vi.\u003c/li\u003e\u003cli\u003eGia đình: Quan tâm, đồng hành, định hướng và giáo dục con em.\u003c/li\u003e\u003cli\u003eNhà trường: Tăng cường giáo dục, hướng dẫn và xây dựng môi trường học tập lành mạnh.\u003c/li\u003e\u003cli\u003eCộng đồng: Phối hợp tuyên truyền, hỗ trợ và tạo điều kiện để học sinh phát triển tích cực.\u003c/li\u003e\u003cli\u003eLàm rõ cách thực hiện và hiệu quả dự kiến của những giải pháp quan trọng.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eKẾT BÀI:\u003cul\u003e\u003cli\u003eKhẳng định lại sự cần thiết phải giải quyết vấn đề.\u003c/li\u003e\u003cli\u003eKêu gọi hành động phù hợp.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\\- Liên hệ bản thân bằng nhận thức và việc làm cụ thể.\u003c/p\u003e\u003cp\u003e\u003cb\u003eĐỀ VỀ VẤN ĐỀ CÓ NHIỀU KHÍA CẠNH CẦN XEM XÉT\u003c/b\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eMỞ BÀI (gián tiếp):\u003cul\u003e\u003cli\u003eDẫn dắt từ một nhận định, thực tế đời sống hoặc chính vấn đề.\u003c/li\u003e\u003cli\u003eGiới thiệu vấn đề cần nghị luận.\u003c/li\u003e\u003cli\u003eNêu ý nghĩa của việc nhận thức và nhìn nhận vấn đề một cách đúng đắn, toàn diện.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eTHÂN BÀI:\u003c/li\u003e\u003cli\u003eLuận điểm 1: Giải thích và xác định bản chất vấn đề\u003cul\u003e\u003cli\u003eGiải thích khái niệm và các từ khóa quan trọng.\u003c/li\u003e\u003cli\u003eXác định vai trò, ý nghĩa của vấn đề trong đời sống học sinh.\u003c/li\u003e\u003cli\u003eNêu thực trạng hoặc bối cảnh cần thiết để làm rõ vấn đề.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLuận điểm 2: Phân tích mặt tích cực và ý nghĩa\u003cul\u003e\u003cli\u003eLàm rõ những lợi ích, giá trị hoặc đóng góp tích cực của vấn đề.\u003c/li\u003e\u003cli\u003ePhân tích tác động đối với bản thân học sinh và đời sống học đường.\u003c/li\u003e\u003cli\u003eĐưa lí lẽ và dẫn chứng để chứng minh.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLuận điểm 3: Phân tích mặt hạn chế và những hệ quả tiêu cực\u003cul\u003e\u003cli\u003eChỉ ra những biểu hiện lệch lạc, bất cập hoặc nguy cơ phát sinh.\u003c/li\u003e\u003cli\u003ePhân tích nguyên nhân và hậu quả khi vấn đề bị nhận thức hoặc thực hiện sai lệch.\u003c/li\u003e\u003cli\u003eĐưa dẫn chứng cụ thể, phù hợp.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLuận điểm 4: Phản biện ý kiến trái chiều\u003cul\u003e\u003cli\u003eXem xét các ý kiến trái chiều hoặc cách nhìn phiến diện.\u003c/li\u003e\u003cli\u003eThừa nhận những điểm hợp lí nếu có, đồng thời chỉ ra giới hạn của từng quan điểm.\u003c/li\u003e\u003cli\u003eĐề xuất cách nhìn nhận cân bằng, có căn cứ.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eLuận điểm 5: Đề xuất giải pháp và định hướng hành động\u003cul\u003e\u003cli\u003eCá nhân: Điều chỉnh nhận thức, lựa chọn hành động phù hợp và có trách nhiệm.\u003c/li\u003e\u003cli\u003eGia đình: Giáo dục, định hướng và đồng hành cùng học sinh.\u003c/li\u003e\u003cli\u003eNhà trường: Hướng dẫn, hỗ trợ và xây dựng môi trường giáo dục tích cực.\u003c/li\u003e\u003cli\u003eCộng đồng: Phối hợp tạo dựng môi trường thuận lợi cho sự phát triển của học sinh.\u003c/li\u003e\u003cli\u003eBảo đảm các giải pháp phù hợp với bản chất vấn đề, có tính khả thi và có thể phối hợp với nhau.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eKẾT BÀI:\u003cul\u003e\u003cli\u003eKhẳng định ý nghĩa của việc nhìn nhận vấn đề toàn diện và đúng đắn.\u003c/li\u003e\u003cli\u003eKêu gọi phát huy mặt tích cực, khắc phục hạn chế hoặc duy trì những giá trị tốt đẹp, tùy theo yêu cầu đề bài.\u003c/li\u003e\u003cli\u003eLiên hệ bản thân bằng nhận thức và hành động cụ thể.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e"},
  "ngu_van/tong-hop": {"mon":"Ngữ Văn","chuong_list":[{"id_chuong":"chuong-1","ten_chuong":"Bài 1: Thế Giới Kì Ảo","danh_sach_bai":[{"id":"01","ten_bai":"Truyện truyền kì","diem":100}]},{"id_chuong":"chuong-2","ten_chuong":"Bài 2: Những Cung Bậc Cảm Xúc","danh_sach_bai":[]},{"id_chuong":"chuong-3","ten_chuong":"Bài 3: Hồn Nước Nằm Trong Tiếng Mẹ Cha","danh_sach_bai":[]},{"id_chuong":"chuong-4","ten_chuong":"Bài 4: Khám Phá Vẻ Đẹp Văn Chương","danh_sach_bai":[]},{"id_chuong":"chuong-5","ten_chuong":"Bài 5: Đối Diện Với Nỗi Đau","danh_sach_bai":[]},{"id_chuong":"chuong-6","ten_chuong":"Bài 6: Giải Mã Những Bí Mật","danh_sach_bai":[]},{"id_chuong":"chuong-7","ten_chuong":"Bài 7: Hồn Thơ Muôn Diệu","danh_sach_bai":[]},{"id_chuong":"chuong-8","ten_chuong":"Bài 8: Tiếng Nói Của Lương Tri","danh_sach_bai":[]},{"id_chuong":"chuong-9","ten_chuong":"Bài 9: Đi Và Suy Ngẫm","danh_sach_bai":[]},{"id_chuong":"chuong-10","ten_chuong":"Bài 10: Văn Học - Lịch Sử Tâm Hồn","danh_sach_bai":[]}]},
  "toan/chuong-1/bai-01": {"ly_thuyet":"\u003ch3\u003e1. Phương trình bậc nhất hai ẩn\u003c/h3\u003e\u003ch4\u003eKhái niệm phương trình bậc nhất hai ẩn\u003c/h4\u003e\u003cul\u003e\u003cli\u003e\u003cb\u003ePhương trình bậc nhất hai ẩn\u003c/b\u003e $x$ và $y$ là hệ thức dạng:\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e$$ax + by = c$$ trong đó $a, b$ và $c$ là các số đã biết ($a \\neq 0$ hoặc $b \\neq 0$).\u003c/p\u003e\u003cul\u003e\u003cli\u003eNếu tại $x = x_0$ và $y = y_0$, ta có $ax_0 + by_0 = c$ là một khẳng định đúng thì cặp số $(x_0; y_0)$ được gọi là một \u003cb\u003enghiệm\u003c/b\u003e của phương trình $ax + by = c$.\u003c/li\u003e\u003c/ul\u003e\u003cblockquote\u003e\u003cp\u003e\u003cb\u003eLưu ý:\u003c/b\u003e - Trong phương trình bậc nhất hai ẩn, các hệ số $a$ và $b$ không đồng thời bằng $0$. - Một phương trình bậc nhất hai ẩn luôn có \u003cb\u003evô số nghiệm\u003c/b\u003e.\u003c/p\u003e\u003c/blockquote\u003e\u003ch4\u003eBiểu diễn tập nghiệm trên mặt phẳng tọa độ\u003c/h4\u003e\u003cul\u003e\u003cli\u003eTrong mặt phẳng tọa độ $Oxy$, tập hợp các điểm có tọa độ $(x; y)$ thỏa mãn phương trình bậc nhất hai ẩn $ax + by = c$ là một đường thẳng, gọi là đường thẳng $ax + by = c$.\u003c/li\u003e\u003cli\u003eCác trường hợp biểu diễn đường thẳng $ax + by = c$:\u003c/li\u003e\u003c/ul\u003e\u003cdiv style=\"overflow-x:auto\"\u003e\u003ctable style=\"border-collapse:collapse;margin:8px 0;min-width:60%\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth style=\"border:1px solid #dfe5ee;padding:6px 10px;background:#f5f8ff;text-align:left\"\u003eTrường hợp\u003c/th\u003e\u003cth style=\"border:1px solid #dfe5ee;padding:6px 10px;background:#f5f8ff;text-align:left\"\u003eDạng đường thẳng\u003c/th\u003e\u003cth style=\"border:1px solid #dfe5ee;padding:6px 10px;background:#f5f8ff;text-align:left\"\u003eĐặc điểm hình học\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e$a \\neq 0$ và $b \\neq 0$\u003c/td\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e$y = -\\frac{a}{b}x + \\frac{c}{b}$\u003c/td\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003eCắt cả hai trục tọa độ $Ox$ và $Oy$\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e$a = 0$ và $b \\neq 0$\u003c/td\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e$y = \\frac{c}{b}$\u003c/td\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003eSong song hoặc trùng với trục hoành $Ox$, cắt trục $Oy$ tại điểm $\\left(0; \\frac{c}{b}\\right)$\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e$a \\neq 0$ và $b = 0$\u003c/td\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003e$x = \\frac{c}{a}$\u003c/td\u003e\u003ctd style=\"border:1px solid #dfe5ee;padding:6px 10px\"\u003eSong song hoặc trùng với trục tung $Oy$, cắt trục $Ox$ tại điểm $\\left(\\frac{c}{a}; 0\\right)$\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003ch3\u003e2. Hệ hai phương trình bậc nhất hai ẩn\u003c/h3\u003e\u003ch4\u003eKhái niệm hệ hai phương trình bậc nhất hai ẩn\u003c/h4\u003e\u003cul\u003e\u003cli\u003eMột cặp gồm hai phương trình bậc nhất hai ẩn $ax + by = c$ và $a\u0027x + b\u0027y = c\u0027$ được gọi là một \u003cb\u003ehệ hai phương trình bậc nhất hai ẩn\u003c/b\u003e.\u003c/li\u003e\u003cli\u003eDạng tổng quát của hệ hai phương trình bậc nhất hai ẩn:\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e$$\\begin{cases} ax + by = c \\\\ a\u0027x + b\u0027y = c\u0027 \\end{cases}$$\u003c/p\u003e\u003cul\u003e\u003cli\u003eMỗi cặp số $(x_0; y_0)$ đồng thời là nghiệm của cả hai phương trình trong hệ được gọi là một \u003cb\u003enghiệm\u003c/b\u003e của hệ phương trình đó.\u003c/li\u003e\u003cli\u003eNếu hai phương trình trong hệ không có nghiệm chung thì ta nói hệ phương trình \u003cb\u003evô nghiệm\u003c/b\u003e.\u003c/li\u003e\u003cli\u003eGiải hệ phương trình là tìm tất cả các nghiệm của hệ đó.\u003c/li\u003e\u003c/ul\u003e\u003ch4\u003eMinh họa hình học nghiệm của hệ hai phương trình bậc nhất hai ẩn\u003c/h4\u003e\u003cblockquote\u003e\u003cp\u003eTrong mặt phẳng tọa độ $Oxy$, gọi đường thẳng $d_1$ là $ax + by = c$ và đường thẳng $d_2$ là $a\u0027x + b\u0027y = c\u0027$: - Nếu $d_1$ cắt $d_2$ tại điểm $M(x_0; y_0)$ thì hệ phương trình có \u003cb\u003enghiệm duy nhất\u003c/b\u003e $(x_0; y_0)$. - Nếu $d_1$ song song với $d_2$ thì hệ phương trình \u003cb\u003evô nghiệm\u003c/b\u003e. - Nếu $d_1$ trùng với $d_2$ thì hệ phương trình có \u003cb\u003evô số nghiệm\u003c/b\u003e.\u003c/p\u003e\u003c/blockquote\u003e","bai_tap":[{"id":"1.1","do_kho":1,"ten":"Khái niệm phương trình và hệ hai phương trình bậc nhất hai ẩn","cau_hoi":[{"id":"1","type":"trac-nghiem","de_bai":"Dạng tổng quát của phương trình bậc nhất hai ẩn $x$ và $y$ là","dap_an":["$ax + by = c$ với $a \\neq 0$ hoặc $b \\neq 0$","$ax^2 + by = c$","$ax + by^2 = c$","$ax + b = 0$"],"diem":2,"goi_y":"Phương trình bậc nhất hai ẩn chứa hai ẩn $x, y$ đều ở bậc $1$."},{"id":"2","type":"trac-nghiem","de_bai":"Phương trình nào sau đây là phương trình bậc nhất hai ẩn $x$ và $y$?","dap_an":["$x^2 + y = 3$","$2x + 0y = 5$","$0x + 0y = 1$","$x + y^2 = 0$"],"diem":2,"goi_y":"Tìm phương trình có dạng $ax + by = c$ với $a \\neq 0$ hoặc $b \\neq 0$."},{"id":"3","type":"trac-nghiem","de_bai":"Phương trình nào dưới đây KHÔNG PHẢI là phương trình bậc nhất hai ẩn?","dap_an":["$x - 3y = 2$","$0x + 4y = -1$","$0x + 0y = 3$","$5x - y = 0$"],"diem":2,"goi_y":"Phương trình không phải bậc nhất hai ẩn khi các hệ số $a$ và $b$ đồng thời bằng $0$."},{"id":"4","type":"trac-nghiem","de_bai":"Các hệ số $a, b, c$ của phương trình bậc nhất hai ẩn $3x - 2y = 7$ lần lượt là","dap_an":["$a = 3, b = 2, c = 7$","$a = -3, b = -2, c = 7$","$a = 3, b = -2, c = -7$","$a = 3, b = -2, c = 7$"],"diem":2,"goi_y":"So sánh phương trình